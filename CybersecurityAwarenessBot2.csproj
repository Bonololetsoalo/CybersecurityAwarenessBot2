<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\welcome.wav" />
    <None Remove="Assets\welcome.wav.ogg" />
    <None Remove="Assets\welcome.wav.wav" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\welcome.wav.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Windows.Extensions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\welcome.wav.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
