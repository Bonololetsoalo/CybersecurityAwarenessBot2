<Window x:Class="CybersecurityAwarenessBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Chatbot" Height="680" Width="820"
        Background="#1E1E2E" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ASCII Banner Header (Fixed with double backslashes & preserve whitespace) -->
        <Border Grid.Row="0" Background="#2B2B3D" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock xml:space="preserve" FontFamily="Consolas" Foreground="#00FFC6" FontSize="9" HorizontalAlignment="Center">
   ______      __              ____        __ 
  / ____/_  _ / /_   ___  ____/ __ )____  / /_
 / /   / / / / __ \/ _ \/ ___/ __  / __ \/ __/
/ /___/ /_/ / /_/ /  __/ /  / /_/ / /_/ / /_  
\____/\__, /_.___/\___/_/  /_____/\____/\__/  
     /____/ </TextBlock>
                <TextBlock Text="CYBERSECURITY AWARENESS CHATBOT" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Chat Output Panel -->
        <Border Grid.Row="1" Background="#252535" CornerRadius="8" Padding="10">
            <ScrollViewer x:Name="ChatScrollViewer">
                <TextBlock x:Name="TxtChatOutput" Foreground="#DCDCAA" TextWrapping="Wrap" FontSize="14" FontFamily="Segoe UI"/>
            </ScrollViewer>
        </Border>

        <!-- Input Panel -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtUserInput" Grid.Column="0" Height="40" Background="#333345" Foreground="White" 
                     FontSize="14" Padding="8" VerticalContentAlignment="Center" KeyDown="TxtUserInput_KeyDown"/>
            <Button x:Name="BtnSend" Grid.Column="1" Content="Send" Width="100" Height="40" Margin="10,0,0,0" 
                    Background="#00FFC6" Foreground="#1E1E2E" FontWeight="Bold" Click="BtnSend_Click"/>
        </Grid>
    </Grid>
</Window>