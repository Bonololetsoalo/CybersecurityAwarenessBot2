<Window x:Class="CybersecurityAwarenessBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Chatbot" Height="740" Width="760"
        WindowStartupLocation="CenterScreen" Background="#121212"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Properly Spaced Full ASCII Art Banner Header -->
        <Border Grid.Row="0" Background="#181824" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#2A2A3C" BorderThickness="1">
            <TextBlock FontFamily="Consolas" FontSize="8.5" LineHeight="11" Foreground="#00D2FF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap">
                <Run Text="   ____      _               ____        _   "/><LineBreak/>
                <Run Text="  / ___|   _| |__   ___ _ __| __ )  ___ | |_ "/><LineBreak/>
                <Run Text=" | |  | | | | '_ \ / _ \ '__|  _ \ / _ \| __|"/><LineBreak/>
                <Run Text=" | |__| |_| | |_) |  __/ |  | |_) | (_) | |_ "/><LineBreak/>
                <Run Text="  \____\__, |_.__/ \___|_|  |____/ \___/ \__|"/><LineBreak/>
                <Run Text="       |___/                                   "/>
            </TextBlock>
        </Border>

        <!-- RichTextBox Chat Display -->
        <Border Grid.Row="1" Background="#181824" CornerRadius="8" Padding="10" BorderBrush="#2A2A3C" BorderThickness="1">
            <RichTextBox x:Name="ChatDisplay" Background="Transparent" BorderThickness="0" 
                         Foreground="#E0E0E0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                         FontFamily="Consolas" FontSize="13">
                <FlowDocument/>
            </RichTextBox>
        </Border>

        <!-- Input Section -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputTextBox" Grid.Column="0" Background="#222230" Foreground="#FFFFFF" 
                     BorderBrush="#3A3A50" BorderThickness="1" Padding="10,8" VerticalContentAlignment="Center" 
                     KeyDown="InputTextBox_KeyDown" CaretBrush="#00D2FF"/>

            <Button Grid.Column="1" Content="Send" Click="SendButton_Click" Margin="10,0,0,0" 
                    Padding="20,8" Background="#00D2FF" Foreground="#121212" FontWeight="Bold" 
                    BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>